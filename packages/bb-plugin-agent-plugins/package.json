{
  "name": "bb-plugin-agent-plugins",
  "version": "0.3.0",
  "type": "module",
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": ">=0.4.16"
  },
  "bb": {
    "name": "Agent Plugins",
    "description": "Install Agent Plugins (skills + MCP) once; flow to every provider.",
    "branding": {
      "icon": "Puzzle"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": []
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build .",
    "prepack": "bb plugin build . && node -e \"const fs=require('node:fs'); for (const file of ['dist/app.js','dist/app.css','dist/app.meta.json','dist/server.js','dist/server.meta.json','dist/host.js','dist/host.meta.json']) { if (!fs.existsSync(file)) throw new Error('Missing release artifact: '+file); }\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.0",
    "hono": "^4.11.9",
    "jsdom": "29.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "typescript": "^5.7.0",
    "vitest": "4.1.1"
  }
}
